# Keep formatter-sensitive source and project files identical on every runner.
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.lock text eol=lf

# Preserve binary documentation assets.
*.ico binary
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
